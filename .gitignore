# ---- PyInstaller build artifacts ----
# The .spec is generated by BUILD_EXE.bat at build time, so we do not track it.
*.spec
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python caches / compiled files ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ---- App-generated runtime files ----
# keymap.json is written when the user learns a custom layout (F12).
keymap.json
# WAV/MP3 exports the app saves.
recordings/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
